<?xml version="1.0" encoding="utf-8"?>
<!--
  Reborn AMOLED, framework layer (One UI 9 / Android 17).
  Dark mode surfaces go to true black; raised surfaces get just enough lift to stay readable.
  Names come from the device's framework-res, see tools/oneui-reference.
-->
<resources>
    <!-- AOSP device-default backgrounds -->
    <color name="background_dark">#ff000000</color>
    <color name="background_device_default_dark">#ff000000</color>
    <color name="background_floating_device_default_dark">#ff0a0a0a</color>
    <color name="background_material_dark">#ff000000</color>
    <color name="background_floating_material_dark">#ff0a0a0a</color>

    <!-- Material 3 system surface roles, dark -->
    <color name="system_background_dark">#ff000000</color>
    <color name="system_surface_dark">#ff000000</color>
    <color name="system_surface_dim_dark">#ff000000</color>
    <color name="system_surface_container_lowest_dark">#ff000000</color>
    <color name="system_surface_container_low_dark">#ff0a0a0a</color>
    <color name="system_surface_container_dark">#ff111111</color>
    <color name="system_surface_container_high_dark">#ff181818</color>
    <color name="system_surface_container_highest_dark">#ff202020</color>
    <color name="system_surface_bright_dark">#ff2a2a2a</color>
    <color name="system_neutral1_900_dark">#ff000000</color>
    <color name="system_neutral1_1000_dark">#ff000000</color>

    <!-- One UI framework colors -->
    <color name="tw_screen_background_color_dark">#ff000000</color>
    <color name="tw_tab_background_color_dark">#ff000000</color>
    <color name="tw_dialog_window_background_color_material_dark">#ff111111</color>
    <color name="tw_dialog_circle_background_color_dark">#ff111111</color>
</resources>
