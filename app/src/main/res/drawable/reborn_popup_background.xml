<?xml version="1.0" encoding="utf-8"?>
<!-- M3E popup container for the View screens' overflow menus, list popups and Spinner dropdowns:
     16 dp corners on surfaceContainerHigh, a hairline on true black (reborn_card_edge is transparent in light) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke android:width="1dp" android:color="@color/reborn_card_edge" />
    <padding android:top="8dp" android:bottom="8dp" />
</shape>
