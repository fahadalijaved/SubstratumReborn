<!--
  Reborn's launcher shortcuts: Themes, Create a theme, Applied and Rescue Me!. The first three open
  the Reborn shell on that tab: LauncherActivity (the exported entry) passes the "tab" extra on to
  RebornActivity. "Customize <theme>" is a dynamic shortcut (RebornShortcuts), published after an
  apply. The id "studio" (an earlier static shortcut) is never used again: Android refuses to
  update an id that was a manifest shortcut.
  -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/app_shortcut_themes"
        android:shortcutDisabledMessage="@string/shortcut_themes_disabled"
        android:shortcutId="themes"
        android:shortcutLongLabel="@string/shortcut_themes"
        android:shortcutShortLabel="@string/shortcut_themes"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="projekt.substratum.LauncherActivity"
            android:targetPackage="projekt.substratum">
            <extra
                android:name="tab"
                android:value="themes" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/app_shortcut_create"
        android:shortcutDisabledMessage="@string/shortcut_create_disabled"
        android:shortcutId="create"
        android:shortcutLongLabel="@string/shortcut_create"
        android:shortcutShortLabel="@string/shortcut_create_short"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="projekt.substratum.LauncherActivity"
            android:targetPackage="projekt.substratum">
            <extra
                android:name="tab"
                android:value="create" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/app_shortcut_applied"
        android:shortcutDisabledMessage="@string/shortcut_applied_disabled"
        android:shortcutId="applied"
        android:shortcutLongLabel="@string/shortcut_applied"
        android:shortcutShortLabel="@string/shortcut_applied"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="projekt.substratum.LauncherActivity"
            android:targetPackage="projekt.substratum">
            <extra
                android:name="tab"
                android:value="applied" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/app_shortcut_rescue"
        android:shortcutDisabledMessage="@string/shortcut_rescue_disabled"
        android:shortcutId="rescue"
        android:shortcutLongLabel="@string/shortcut_rescue"
        android:shortcutShortLabel="@string/shortcut_rescue"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="projekt.substratum.activities.shortcuts.RescueActivity"
            android:targetPackage="projekt.substratum" />
    </shortcut>
</shortcuts>
